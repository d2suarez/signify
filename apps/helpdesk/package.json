{
  "name": "signify-helpdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DEV=1 HELPDESK_DEV_USER=admin PORT=3110 node server.js",
    "build": "prisma generate && next build",
    "start": "prisma db push --skip-generate && node prisma/seed.mjs && node server.js",
    "local": "prisma db push --skip-generate && HELPDESK_DEV_USER=admin PORT=3110 node server.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "marked": "^18.0.7",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "server.js",
  "engines": {
    "node": ">=22"
  }
}
