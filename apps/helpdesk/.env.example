# --- Required ---
# SQLite database. Relative paths resolve from prisma/.
# Local:   file:../data/helpdesk.db      Railway (volume at /data): file:/data/helpdesk.db
DATABASE_URL="file:../data/helpdesk.db"

# Public address, for links in notifications and the Desk ticket box.
APP_URL="https://help.signify.one"
CANONICAL_HOST="help.signify.one"
UPLOAD_DIR="/data/uploads"

# --- Signify ID (sign-in) ---
# Register once on Signify ID:  node src/register-app.js --client-id signify-helpdesk ...
SIGNIFY_ISSUER="https://id.signify.one"
SIGNIFY_CLIENT_ID="signify-helpdesk"
SIGNIFY_CLIENT_SECRET=""
SIGNIFY_REDIRECT_URI="https://help.signify.one/auth/callback"
SIGNIFY_COOKIE_SECRET=""            # openssl rand -hex 32
# Only members of this school may use the help desk (a Signify ID tenant id). Optional.
# HELPDESK_TENANT_ID=""

# Origins allowed to use /api/desk (the ticket box on Teacher's Desk).
DESK_ORIGINS="https://desk.signify.one"

# Shown in page titles, e.g. "Riverside Christian School"
NEXT_PUBLIC_SCHOOL_NAME=""

# --- Local development only (refuses to start on Railway) ---
# HELPDESK_DEV_USER="admin"         # admin | agent | staff | student; switch with /dev/as/<who>

# --- Optional: push (app) notifications ---
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:it@yourschool.org"

# --- Optional: email (SMTP). Railway's Hobby plan blocks outbound SMTP. ---
# SMTP_HOST="" SMTP_PORT="587" SMTP_USER="" SMTP_PASS=""
# MAIL_FROM="Signify Help Desk <helpdesk@yourschool.org>"
# HELPDESK_NOTIFY_EMAIL="it@yourschool.org"

# --- Optional: text messages via Twilio ---
# TWILIO_ACCOUNT_SID="" TWILIO_AUTH_TOKEN="" TWILIO_FROM="+15551234567"

# --- Optional tuning ---
# STALE_DAYS="5"  DIGEST_DOW="1"  DIGEST_UTC_HOUR="11"
