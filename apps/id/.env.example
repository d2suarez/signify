# ---- required ----
DATABASE_URL=postgresql://user:pass@host:5432/signify_id
# Google Cloud OAuth client (Web application). The ONLY Google client the whole
# fleet needs now — individual apps no longer talk to Google directly.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Public origin of this service. Must be exact; it becomes the OIDC issuer.
ISSUER=https://id.signify.one
# Comma-separated. Keep at least two so a lost account cannot lock you out.
SUPER_ADMINS=desmond@signify.one,d2suarez@gmail.com

# ---- optional ----
PORT=3000
# Cookie signing / CSRF pepper. Generate with: openssl rand -hex 32
# Leave unset ONLY in local development.
COOKIE_SECRET=
# Idle minutes before a session ends. Shared classroom devices want this low.
SESSION_IDLE_MINUTES=45
SESSION_IDLE_MINUTES_MINOR=20
SESSION_ABSOLUTE_HOURS=12
# Platform default retention for inactive student records (days).
RETENTION_DAYS=400
# Local development only: skips Google and trusts a typed email. Refuses to
# start when RAILWAY_ENVIRONMENT is present.
ALLOW_DEV_LOGIN=0
