# ---- Signify ID (https://id.signify.one) ----
# Register the app there first: Applications -> Register an app
#   namespace: desk
#   redirect:  https://desk.signify.one/auth/callback
SIGNIFY_ISSUER=https://id.signify.one
SIGNIFY_CLIENT_ID=
SIGNIFY_CLIENT_SECRET=
SIGNIFY_REDIRECT_URI=https://desk.signify.one/auth/callback
SIGNIFY_COOKIE_SECRET=

# ---- This app ----
PORT=8770
DATA_DIR=./data
# Sign-in only works on an authorised Google domain, so send the
# *.up.railway.app host to the real one.
CANONICAL_HOST=desk.signify.one

# Behaviour notes are deleted this many days after they are written.
# The school's own retention setting in Signify ID is the ceiling; this is
# the desk's default and is deliberately short.
BEHAVIOUR_RETENTION_DAYS=90

# Local development only. Signs you in as a made-up teacher so the board can
# be worked on without the identity service. Refuses to start in production.
# DESK_DEV_USER=1
